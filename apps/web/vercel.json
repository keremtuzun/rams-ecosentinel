{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "functions": {
    "app/api/queues/analysis/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "ecosentinel-analysis-v1",
          "maxConcurrency": 1
        }
      ]
    }
  }
}
